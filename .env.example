# ------------------------------------------------------------------
# MediCore — Environment Template
# Copy to .env and adjust values for your machine.
#   cp .env.example .env
# ------------------------------------------------------------------
APP_NAME="MediCore HMS"
APP_ENV=local            # local | staging | production
APP_DEBUG=false          # NEVER enable in production
APP_URL=http://localhost:8090
APP_KEY=                 # random 32-char string (php console key:generate)
APP_TIMEZONE=UTC

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medicore
DB_USERNAME=root
DB_PASSWORD=

# Session / Security
SESSION_NAME=MEDICORE_SESSION
SESSION_LIFETIME=7200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
